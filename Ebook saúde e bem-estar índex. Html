<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Saúde e Bem-Estar — Guia Digital</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,600&display=swap" rel="stylesheet">
<style>
  :root{
    --dark:#053B22;
    --dark2:#07622F;
    --light:#5CD62B;
    --light2:#9CF25A;
    --aqua:#00D9B5;
    --aqua2:#3BFFDD;
    --cream:#E8F8ED;
    --white:#FFFFFF;
    --text:#0C1F14;
    --muted:#4C6656;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{font-family:'Poppins',sans-serif; color:var(--text); background:var(--white); line-height:1.6;}
  img{max-width:100%; display:block;}
  a{text-decoration:none;}
  .wrap{max-width:1120px; margin:0 auto; padding:0 24px;}
  .btn{
    display:inline-block; font-weight:800; font-size:16px; letter-spacing:.3px;
    padding:16px 34px; border-radius:50px; cursor:pointer; border:none;
    transition:transform .15s ease, box-shadow .15s ease;
  }
  .btn:hover{ transform:translateY(-2px); }
  .btn-primary{ background:linear-gradient(120deg, var(--aqua), var(--light)); color:var(--dark); box-shadow:0 10px 24px rgba(0,217,181,.35); }
  .btn-outline{ background:transparent; border:2px solid #fff; color:#fff; }
  .badge{ display:inline-flex; align-items:center; gap:8px; background:rgba(255,255,255,.15); border:1.5px solid rgba(255,255,255,.5); color:#fff; font-weight:700; font-size:13px; letter-spacing:1px; padding:8px 18px; border-radius:30px; }

  /* HEADER */
  header{ position:sticky; top:0; z-index:50; background:var(--dark); padding:14px 0; }
  header .wrap{ display:flex; align-items:center; justify-content:space-between; }
  .logo{ color:#fff; font-weight:800; font-size:18px; letter-spacing:.5px; }
  .logo span{ color:var(--light2); }
  header .btn{ padding:10px 22px; font-size:14px; }

  /* HERO */
  .hero{ background:radial-gradient(circle at 15% 20%, var(--dark2), var(--dark) 60%); position:relative; overflow:hidden; padding:70px 0 90px 0; }
  .hero::before{ content:""; position:absolute; width:520px; height:520px; border-radius:50%; background:var(--aqua); opacity:.18; top:-220px; right:-160px; }
  .hero::after{ content:""; position:absolute; width:300px; height:300px; border-radius:50%; background:var(--light); opacity:.16; bottom:-140px; left:-100px; }
  .hero .wrap{ display:grid; grid-template-columns:1.1fr .9fr; gap:50px; align-items:center; position:relative; z-index:2; }
  .hero h1{ color:#fff; font-size:44px; font-weight:900; line-height:1.15; margin:20px 0 18px 0; }
  .hero h1 em{ font-style:normal; color:var(--light2); }
  .hero p.sub{ color:#DFF7EA; font-size:18px; font-weight:500; margin-bottom:28px; max-width:520px; }
  .hero .proof{ margin-top:26px; display:flex; gap:22px; flex-wrap:wrap; }
  .hero .proof div{ color:#fff; font-size:13px; font-weight:600; opacity:.85; }

  /* Book mockup */
  .book-mock{ position:relative; display:flex; justify-content:center; }
  .book{
    width:280px; height:392px; border-radius:6px 14px 14px 6px;
    background:linear-gradient(150deg, var(--dark) 0%, var(--dark2) 38%, var(--aqua) 100%);
    box-shadow: -18px 22px 50px rgba(0,0,0,.45), inset -6px 0 12px rgba(0,0,0,.25);
    transform:rotate(-6deg);
    position:relative; padding:26px 22px; color:#fff;
  }
  .book::before{ content:""; position:absolute; left:0; top:0; bottom:0; width:14px; background:rgba(0,0,0,.25); border-radius:6px 0 0 6px; }
  .book .tag{ display:inline-block; font-size:9px; font-weight:800; letter-spacing:1.5px; background:rgba(255,255,255,.2); padding:4px 10px; border-radius:20px; margin-bottom:18px; }
  .book h3{ font-size:26px; font-weight:900; line-height:1.1; }
  .book h3 span{ color:var(--light2); display:block; }
  .book .line{ width:50px; height:3px; background:var(--aqua2); margin:14px 0; border-radius:3px; }
  .book .foot{ position:absolute; bottom:20px; left:22px; right:22px; font-size:10px; font-weight:700; letter-spacing:1px; opacity:.85; }

  /* SECTION generic */
  section{ padding:80px 0; }
  .eyebrow{ color:var(--dark2); font-weight:800; font-size:13px; letter-spacing:2px; text-transform:uppercase; }
  h2.h2{ font-size:34px; font-weight:900; color:var(--dark); margin:10px 0 14px 0; }
  .lead{ color:var(--muted); font-size:17px; max-width:640px; margin-bottom:40px; }

  /* PAIN */
  .pain{ background:var(--cream); }
  .pain-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
  .pain-card{ background:#fff; border-radius:16px; padding:28px; border:1px solid #D7EFDF; }
  .pain-card .ico{ width:46px; height:46px; border-radius:12px; background:var(--dark); color:#fff; display:flex; align-items:center; justify-content:center; font-size:20px; font-weight:800; margin-bottom:16px; }
  .pain-card h4{ font-size:17px; font-weight:800; margin-bottom:8px; color:var(--dark); }
  .pain-card p{ color:var(--muted); font-size:14.5px; }

  /* CHAPTERS */
  .chapters-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:16px; }
  .chapter-item{ display:flex; gap:16px; align-items:flex-start; background:var(--cream); border-radius:14px; padding:18px 20px; }
  .chapter-num{ min-width:38px; height:38px; border-radius:50%; background:var(--dark); color:#fff; font-weight:900; font-size:14px; display:flex; align-items:center; justify-content:center; }
  .chapter-item h4{ font-size:15.5px; font-weight:800; color:var(--dark); }
  .chapter-item p{ font-size:13.5px; color:var(--muted); margin-top:2px; }

  /* FOR WHO */
  .forwho{ background:linear-gradient(120deg, var(--dark), var(--dark2)); color:#fff; }
  .forwho h2.h2{ color:#fff; }
  .forwho .lead{ color:#DFF7EA; }
  .forwho-grid{ display:grid; grid-template-columns:1fr 1fr; gap:40px; }
  .forwho-col{ background:rgba(255,255,255,.06); border-radius:16px; padding:28px; }
  .forwho-col h4{ font-size:17px; font-weight:800; margin-bottom:14px; }
  .forwho-col ul{ list-style:none; }
  .forwho-col li{ padding:6px 0 6px 26px; position:relative; font-size:14.5px; color:#EAFBF3; }
  .forwho-col li::before{ position:absolute; left:0; top:6px; font-weight:900; }
  .col-yes li::before{ content:"✓"; color:var(--light2); }
  .col-no li::before{ content:"✕"; color:#FF8C8C; }

  /* PRICING */
  .pricing{ text-align:center; background:var(--cream); }
  .price-card{ max-width:460px; margin:0 auto; background:#fff; border-radius:22px; padding:44px 36px; box-shadow:0 20px 50px rgba(5,59,34,.12); border:2px solid var(--aqua); }
  .price-card .badge2{ display:inline-block; background:var(--light); color:var(--dark); font-weight:800; font-size:12px; letter-spacing:1px; padding:6px 16px; border-radius:20px; margin-bottom:18px; }
  .price-old{ color:#9AA; text-decoration:line-through; font-size:18px; }
  .price-new{ font-size:52px; font-weight:900; color:var(--dark); margin:6px 0 4px 0; }
  .price-new span{ font-size:18px; font-weight:700; color:var(--muted); }
  .price-list{ text-align:left; margin:26px 0; list-style:none; }
  .price-list li{ padding:7px 0 7px 28px; position:relative; font-size:14.5px; font-weight:600; }
  .price-list li::before{ content:"✓"; position:absolute; left:0; top:7px; width:18px; height:18px; border-radius:50%; background:var(--aqua); color:#fff; font-size:11px; font-weight:800; text-align:center; line-height:18px; }
  .price-card .btn{ width:100%; text-align:center; font-size:18px; }
  .price-note{ margin-top:14px; font-size:12.5px; color:var(--muted); }

  /* FAQ */
  details{ border-bottom:1px solid #D7EFDF; padding:18px 0; }
  summary{ font-weight:700; font-size:16px; cursor:pointer; color:var(--dark); list-style:none; display:flex; justify-content:space-between; align-items:center; }
  summary::-webkit-details-marker{ display:none; }
  summary::after{ content:"+"; font-size:22px; font-weight:400; color:var(--aqua); }
  details[open] summary::after{ content:"–"; }
  details p{ margin-top:12px; color:var(--muted); font-size:14.5px; }

  /* FOOTER CTA */
  .final-cta{ background:radial-gradient(circle at 80% 20%, var(--dark2), var(--dark) 65%); color:#fff; text-align:center; }
  .final-cta h2.h2{ color:#fff; }
  .final-cta .lead{ color:#DFF7EA; margin-left:auto; margin-right:auto; }

  footer{ background:var(--dark); color:#BFE8CF; padding:34px 0; text-align:center; font-size:13px; }

  @media (max-width:860px){
    .hero .wrap{ grid-template-columns:1fr; }
    .book-mock{ order:-1; margin-bottom:10px; }
    .pain-grid{ grid-template-columns:1fr; }
    .chapters-grid{ grid-template-columns:1fr; }
    .forwho-grid{ grid-template-columns:1fr; }
    h2.h2{ font-size:27px; }
    .hero h1{ font-size:32px; }
  }
</style>
</head>
<body>

